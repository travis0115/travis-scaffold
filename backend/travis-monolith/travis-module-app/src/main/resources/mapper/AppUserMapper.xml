<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travis.monolith.app.user.internal.mapper.AppUserMapper">

    <!-- 查询有效客户端用户总数及今日新增数。 -->
    <select id="selectCountSummary"
            resultType="com.travis.monolith.app.user.internal.model.AppUserCountSummary">
        SELECT COUNT(*) AS total,
               COALESCE(SUM(CASE WHEN create_time &gt;= #{todayStart} THEN 1 ELSE 0 END), 0) AS new_today
        FROM app_user
        WHERE is_deleted = 0
    </select>

</mapper>
