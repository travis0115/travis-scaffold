# 部署目录必须是明确绝对路径，脚本会拒绝 /、用户家目录和仓库根目录。
DEPLOY_ROOT=/opt/travis

# 首次部署的业务镜像和副本数。镜像必须使用不可变 tag 或 digest，禁止 latest。
BACKEND_IMAGE=registry.example.com/travis-scaffold:1.0.0
APP_REPLICAS=2
ACTIVE_RELEASE=v1
PREVIOUS_RELEASE=
PREVIOUS_BACKEND_IMAGE=

# 公网入口与 TLS。证书应在执行 first-deploy.sh 前准备好。
PUBLIC_DOMAIN=example.com
TLS_CERTIFICATE=/etc/letsencrypt/live/example.com/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/example.com/privkey.pem
FRONTEND_ROOT=/opt/travis/frontend/current
NGINX_SITE_FILE=/etc/nginx/conf.d/travis.conf
NGINX_UPSTREAM_FILE=/etc/nginx/conf.d/travis-upstreams.conf
NGINX_RATE_LIMIT_FILE=/etc/nginx/conf.d/travis-login-rate-limit.conf

# MySQL
MYSQL_DATABASE=travis_monolith
MYSQL_USERNAME=travis
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Redis
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_DATABASE=0

# 应用密钥，建议至少 32 个随机字符。
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# 当业务模块引入 RocketMQ starter 时，填写外部或独立部署的集群配置。
ROCKETMQ_NAMESRV_ADDR=
ROCKETMQ_CONSUMER_ENDPOINTS=
ROCKETMQ_CONSUMER_ACCESS_KEY=
ROCKETMQ_CONSUMER_SECRET_KEY=
ROCKETMQ_PRODUCER_ENDPOINTS=
ROCKETMQ_PRODUCER_ACCESS_KEY=
ROCKETMQ_PRODUCER_SECRET_KEY=

# 运维参数
HEALTH_TIMEOUT_SECONDS=120
DRAIN_SECONDS=15
ADMIN_LOGIN_RATE=20
ADMIN_LOGIN_BURST=10
APP_LOGIN_RATE=300
APP_LOGIN_BURST=100
